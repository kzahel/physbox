{
  "name": "physbox5",
  "private": true,
  "type": "module",
  "scripts": {
    "check:host": "bash scripts/setup-host.sh --check",
    "setup:host": "bash scripts/setup-host.sh --install",
    "android:apk": "bash android/build-apk.sh",
    "android:avd": "bash android/validate-avd.sh",
    "android:benchmark-avd": "bash android/benchmark-gpu.sh --avd",
    "android:benchmark-bodies-avd": "bash android/benchmark-bodies.sh --avd",
    "android:benchmark-bodies-device": "bash android/benchmark-bodies.sh --device",
    "android:benchmark-device": "bash android/benchmark-gpu.sh --device",
    "android:pacing-device": "bash android/validate-pacing.sh",
    "android:device": "bash android/validate-device.sh",
    "android:env": "bash android/check-env.sh",
    "build:web": "node scripts/build-web.mjs",
    "bundle:web": "node scripts/build-web.mjs --release --output dist-web",
    "benchmark:bodies-browser": "node scripts/browser-body-benchmark.mjs",
    "check:boundaries": "node scripts/check-platform-boundaries.mjs",
    "deploy": "bash scripts/deploy-web.sh",
    "deploy:dry-run": "bash scripts/deploy-web.sh --dry-run",
    "hooks:install": "bash scripts/install-git-hooks.sh",
    "references:status": "node scripts/references.mjs status",
    "references:sync": "node scripts/references.mjs sync",
    "serve:web": "node scripts/serve-web.mjs",
    "test:desktop": "bash scripts/with-host-env.sh --linux-x11 node scripts/desktop-smoke.mjs",
    "test:host-tools": "node --test scripts/host-env.test.mjs",
    "test:android-tools": "node --test android/*.test.mjs",
    "test:web": "node scripts/browser-smoke.mjs",
    "prepare": "bash scripts/install-git-hooks.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "pngjs": "^7.0.0",
    "wrangler": "4.110.0"
  }
}
